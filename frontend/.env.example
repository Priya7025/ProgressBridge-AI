# ==============================================================================
# ProgressBridge AI - Frontend Environment Variables Template
# ==============================================================================
# Usage:
#   Copy this file to .env.local:
#   cp .env.example .env.local
# ==============================================================================

# Public Supabase Client (Exposed to Browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-side Supabase credentials (for Next.js API route handlers)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Ingestion Webhook / n8n endpoints (set once n8n webhook is live)
INGESTION_WEBHOOK_URL=
N8N_WEBHOOK_BASE_URL=

# Demo Project Default Identifier
NEXT_PUBLIC_DEMO_PROJECT_ID=00000000-0000-0000-0000-000000000001
