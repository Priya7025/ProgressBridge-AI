# ==============================================================================
# ProgressBridge AI (SIH26122) - Environment Variables Configuration Template
# ==============================================================================
# NOTE: This file contains ONLY placeholder values for development & production.
# NEVER commit real keys, tokens, credentials, or secrets to Git.
#
# Usage:
#   Copy this file to .env or .env.local and fill in your actual credentials:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database & Backend Configuration
# ------------------------------------------------------------------------------
# Public URL and Anon Key for client-side browser requests (Next.js public access)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-side Supabase credentials (DO NOT EXPOSE TO BROWSER CLIENTS)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 2. AI Extraction & LLM Configuration (Member 1)
# ------------------------------------------------------------------------------
# API Key and model identifier for document information extraction
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-2.5-flash
# Alternative LLM Provider keys (if using OpenAI / Anthropic / Gemini)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. Vector Embeddings Configuration (Member 2)
# ------------------------------------------------------------------------------
# Voyage AI API key for generate-embeddings Edge Function and semantic matching
VOYAGE_API_KEY=your_voyage_api_key_here
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_MODEL=voyage-3

# ------------------------------------------------------------------------------
# 4. Ingestion Webhook & Automation Workflow (Member 1)
# ------------------------------------------------------------------------------
# n8n or Supabase Edge Function document ingestion webhook URL
INGESTION_WEBHOOK_URL=http://127.0.0.1:54321/functions/v1/document-ingest
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook

# ------------------------------------------------------------------------------
# 5. Frontend & Shared Golden Demo Project Defaults (Member 3 & Member 4)
# ------------------------------------------------------------------------------
FRONTEND_API_URL=http://localhost:3000
# Shared Golden Demo Project Identifier (not a secret)
DEMO_PROJECT_ID=1c1711c7-11f8-43f0-babe-e6a7cefe1ad4
NEXT_PUBLIC_DEMO_PROJECT_ID=1c1711c7-11f8-43f0-babe-e6a7cefe1ad4
POLL_TIMEOUT_SECS=10
