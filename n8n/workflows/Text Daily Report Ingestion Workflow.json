      "id": "25b65beb-4472-471c-bf3c-36bbbcd3dc18",
      "name": "Validate & Sanitize Input"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Validate & Sanitize Input').item.json.text_content }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "IMPORTANT EVENT TYPE RULE: The \"event_type\" field MUST contain exactly one of these values: STARTED IN_PROGRESS COMPLETED ON_HOLD BLOCKED CANCELLED  NEVER use values such as \"Progress Update\", \"Started Work\", \"Work Started\", \"Progress\", or any other variation.  If the text describes work that is currently progressing, use exactly: \"IN_PROGRESS\"IMPORTANT: Always extract numeric quantities and their units when present in the input. For example, \"Poured 120m3 concrete\" must produce: quantity: 120 unit: \"m3\"  Do not leave quantity null when a measurable quantity is explicitly present. Extract units such as m3, m2, kg, ton, meter, mm, %, nos, etc."
            }
          ]
        }
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        1728,
        144
      ],
      "id": "81d4798d-472f-4a93-96e6-62da141316db",
      "name": "AI Extraction",
      "retryOnFail": true,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const rawOutput = $json.output ?? $json.text ?? $json.response?.output ?? $json.response?.text ?? \"\";\n\nconst originalText = $('Validate & Sanitize Input').first().json.text_content;\nconst projectId = $('Validate & Sanitize Input').first().json.project_id;\n\nlet parsed;\n\ntry {\n  // Structured Output Parser may already return an object\n  if (typeof rawOutput === \"object\" && rawOutput !== null) {\n    parsed = rawOutput;\n  } else {\n    let cleaned = String(rawOutput).trim();\n\n    if (cleaned.startsWith(\"```json\")) {\n      cleaned = cleaned.replace(/^```json/, \"\").replace(/```$/, \"\").trim();\n    } else if (cleaned.startsWith(\"```\")) {\n      cleaned = cleaned.replace(/^```/, \"\").replace(/```$/, \"\").trim();\n    }\n\n    parsed = JSON.parse(cleaned);\n  }\n} catch (err) {\n  throw new Error(\n    `AI Extraction Error: Failed to parse LLM output as JSON. Raw output: ${JSON.stringify(rawOutput)}`\n  );\n}\n\nif (!parsed || typeof parsed !== 'object' || Array.isArray(parsed) || !Array.isArray(parsed.events)) {\n  throw new Error(\n    \"AI Extraction Error: Model output must be an object containing a root 'events' array.\"\n  );\n}\n\nconst ALLOWED_EVENT_TYPES = [\n  \"STARTED\",\n  \"IN_PROGRESS\",\n  \"COMPLETED\",\n  \"ON_HOLD\",\n  \"BLOCKED\",\n  \"CANCELLED\"\n];\n\nconst ALLOWED_DISCIPLINES = [\n  \"Civil\",\n  \"Piping\",\n  \"Mechanical\",\n  \"Electrical\",\n  \"Instrumentation\",\n  \"HSE\"\n];\n\nconst DATE_REGEX = /^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$/;\nconst TIME_REGEX = /^([01]\\d|2[0-3]):[0-5]\\d$/;\n\nconst validatedEvents = parsed.events.map((evt, idx) => {\n\n  if (\n    !evt.activity_description ||\n    typeof evt.activity_description !== 'string' ||\n    evt.activity_description.trim() === ''\n  ) {\n    throw new Error(\n      `Validation Error [Event ${idx}]: 'activity_description' is required and must be a non-empty string.`\n    );\n  }\n\n  if (\n    !evt.event_type ||\n    !ALLOWED_EVENT_TYPES.includes(evt.event_type)\n  ) {\n    throw new Error(\n      `Validation Error [Event ${idx}]: Invalid 'event_type' ('${evt.event_type}'). Allowed: ${ALLOWED_EVENT_TYPES.join(', ')}.`\n    );\n  }\n\n  if (\n    !evt.source_evidence ||\n    typeof evt.source_evidence !== 'string' ||\n    evt.source_evidence.trim() === ''\n  ) {\n    throw new Error(\n      `Validation Error [Event ${idx}]: 'source_evidence' is required and must be a non-empty string.`\n    );\n  }\n\n  if (!originalText.includes(evt.source_evidence)) {\n    throw new Error(\n      `Validation Error [Event ${idx}]: 'source_evidence' is not an exact verbatim substring of the input text.`\n    );\n  }\n\n  if (\n    evt.discipline !== null &&\n    !ALLOWED_DISCIPLINES.includes(evt.discipline)\n  ) {\n    throw new Error(\n      `Validation Error [Event ${idx}]: Invalid 'discipline' ('${evt.discipline}'). Allowed: ${ALLOWED_DISCIPLINES.join(', ')} or null.`\n    );\n  }\n\n  if (evt.event_date !== null) {\n    if (\n      typeof evt.event_date !== 'string' ||\n      !DATE_REGEX.test(evt.event_date)\n    ) {\n      throw new Error(\n        `Validation Error [Event ${idx}]: Invalid 'event_date' ('${evt.event_date}'). Must be format 'YYYY-MM-DD' or null.`\n      );\n    }\n  }\n\n  if (evt.event_time !== null) {\n    if (\n      typeof evt.event_time !== 'string' ||\n      !TIME_REGEX.test(evt.event_time)\n    ) {\n      throw new Error(\n        `Validation Error [Event ${idx}]: Invalid 'event_time' ('${evt.event_time}'). Must be 24-hour format 'HH:MM' or null.`\n      );\n    }\n  }\n\n  if (\n    evt.asset !== null &&\n    (typeof evt.asset !== 'string' || evt.asset.trim() === '')\n  ) {\n    throw new Error(\n      `Validation Error [Event ${idx}]: 'asset' must be a valid string or null.`\n    );\n  }\n\n  if (\n    evt.location !== null &&\n    (typeof evt.location !== 'string' || evt.location.trim() === '')\n  ) {\n    throw new Error(\n      `Validation Error [Event ${idx}]: 'location' must be a valid string or null.`\n    );\n  }\n\nif (\n  evt.quantity !== null &&\n  evt.quantity !== undefined &&\n  (\n    (typeof evt.quantity !== 'number' && typeof evt.quantity !== 'string') ||\n    (typeof evt.quantity === 'string' && evt.quantity.trim() === '')\n  )\n) {\n  throw new Error(\n    `Validation Error [Event ${idx}]: 'quantity' must be a valid number, string, or null.`\n  );\n}\n\n  if (\n    evt.delay_reason !== null &&\n    (typeof evt.delay_reason !== 'string' || evt.delay_reason.trim() === '')\n  ) {\n    throw new Error(\n      `Validation Error [Event ${idx}]: 'delay_reason' must be a valid string or null.`\n    );\n  }\n\n  return {\n    document_id: null,\n    project_id: projectId,\n    discipline: evt.discipline,\n    activity_description: evt.activity_description.trim(),\n    asset: evt.asset ? evt.asset.trim() : null,\n    location: evt.location ? evt.location.trim() : null,\n    event_type: evt.event_type,\n    event_date: evt.event_date,\n    event_time: evt.event_time,\n    quantity:\n       evt.quantity !== null && evt.quantity !== undefined\n        ? String(evt.quantity)\n        : null,\n    delay_reason: evt.delay_reason ? evt.delay_reason.trim() : null,\n    source_evidence: evt.source_evidence\n  };\n});\n\nreturn [\n  {\n    json: {\n      project_id: projectId,\n      events_count: validatedEvents.length,\n      events: validatedEvents\n    }\n  }\n];"
      },
