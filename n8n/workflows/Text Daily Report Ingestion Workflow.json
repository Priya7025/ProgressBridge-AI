    {
      "parameters": {
        "jsCode": "const match = $input.first().json;\n\nconst event = $('Create a row').item.json;\n\nlet status;\n\nif (match.match_status === 'AUTO_MATCHED') {\n  status = 'AUTO_MATCHED';\n} else if (match.match_status === 'PENDING_REVIEW') {\n  status = 'PENDING_REVIEW';\n} else {\n  status = 'UNMATCHED';\n}\n\nreturn [\n  {\n    json: {\n      success: true,\n\n      status: status,\n\n      message:\n        status === 'AUTO_MATCHED'\n          ? 'Activity automatically matched to the schedule.'\n          : status === 'PENDING_REVIEW'\n          ? 'Activity requires planner review before schedule update.'\n          : 'No sufficiently confident schedule match was found.',\n\n      data: {\n        project_id: event.project_id || null,\n        document_id: event.document_id || null,\n\n        activity_id: match.activity_id || null,\n        activity_code: match.activity_code || null,\n        description: match.description || null,\n\n        discipline: event.discipline || null,\n        location: event.location || null,\n        event_type: event.event_type || null,\n        quantity: event.quantity ?? null,\n\n        semantic_score: match.semantic_score ?? 0,\n        identifier_score: match.identifier_score ?? 0,\n        discipline_score: match.discipline_score ?? 0,\n        location_score: match.location_score ?? 0,\n\n        final_score: match.final_score ?? 0,\n\n        match_status: status,\n        matched: match.matched ?? false\n      }\n    }\n  }\n];"
      },
