        "jsCode": "const items = $input.all();\n\nconst candidates = items\n  .filter(item =>\n    item.json.final_score !== undefined &&\n    item.json.final_score !== null\n  )\n  .sort((a, b) =>\n    Number(b.json.final_score) - Number(a.json.final_score)\n  );\n\nif (candidates.length === 0) {\n  return [{\n    json: {\n      match_status: 'UNMATCHED',\n      final_score: 0,\n      matched: false\n    }\n  }];\n}\n\nconst top = candidates[0].json;\nconst score = Number(top.final_score);\n\nlet match_status;\nlet matched;\n\nif (score >= 0.90) {\n  match_status = 'AUTO_MATCHED';\n  matched = true;\n} else if (score >= 0.50) {\n  match_status = 'PENDING_REVIEW';\n  matched = false;\n} else {\n  match_status = 'UNMATCHED';\n  matched = false;\n}\n\nreturn [{\n  json: {\n    ...top,\n    match_status,\n    matched\n  }\n}];"
      },
