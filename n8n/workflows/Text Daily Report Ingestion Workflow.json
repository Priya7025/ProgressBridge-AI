    {
      "parameters": {
        "jsCode": "const payload = $json.body || $json;\n\nif (\n  !payload.project_id ||\n  typeof payload.project_id !== 'string' ||\n  payload.project_id.trim() === ''\n) {\n  throw new Error(\n    \"Validation Error: 'project_id' is required and must be a valid non-empty string.\"\n  );\n}\n\nif (\n  !payload.text_content ||\n  typeof payload.text_content !== 'string' ||\n  payload.text_content.trim() === ''\n) {\n  throw new Error(\n    \"Validation Error: 'text_content' is required and cannot be empty.\"\n  );\n}\n\nconst sanitized = {\n  project_id: payload.project_id.trim(),\n  text_content: payload.text_content.trim(),\n  filename:\n    payload.filename &&\n    typeof payload.filename === 'string' &&\n    payload.filename.trim()\n      ? payload.filename.trim()\n      : 'daily_report.txt',\n  source_type:\n    payload.source_type &&\n    typeof payload.source_type === 'string' &&\n    payload.source_type.trim()\n      ? payload.source_type.trim()\n      : 'text',\n  uploaded_by: payload.uploaded_by || null,\n  received_at: new Date().toISOString()\n};\n\nreturn [{ json: sanitized }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
